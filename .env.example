# 安居家电售后智能客服 —— 模型配置示例
# 本工程不再内置天气查询工具，无需配置 OPENWEATHER_API_KEY。
# 所有模型走 OpenAI 兼容接口，可按需选型：
# - qwen：阿里云百炼/DashScope，OpenAI 兼容 Base URL
# - deepseek：DeepSeek 开放平台（聊天可用；无通用 Embedding，嵌入需另配 qwen/zhipu/openai）
# - zhipu：智谱 BigModel，OpenAI 兼容 Base URL
# - openai：OpenAI 官方 Base URL
# 无可用 Key 时也可正常启动：任务分类等 LLM 调用会降级为兜底文案，RAG 检索跳过向量索引。
MODEL_PROVIDER=qwen
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=your_openai_compatible_chat_base_url_here
LLM_MODEL=your_chat_model_name_here

# --- 模型分级 fast 通道（可选）---
# 任务分类、咨询相关性判定、槽位抽取等高频结构化短调用走 fast 通道（小/轻量模型），
# 生成类（话术/RAG 回答/回访）走上方 main 通道。fast 通道不配置时透明回退 main 模型。
# LLM_FAST_MODEL=your_small_fast_chat_model_name_here
# MODEL_FAST_PROVIDER=qwen   # 可选：fast 独立提供商，缺省同 MODEL_PROVIDER
# Azure 模式对应：AZURE_FAST_DEPLOYMENT=your_small_fast_deployment_name_here

# Embeddings can use a different provider/model from the chat LLM.
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=your_openai_compatible_embedding_base_url_here
EMBEDDING_MODEL=your_embedding_model_name_here

# Optional Azure OpenAI mode:
# If you set MODEL_PROVIDER=azure or EMBEDDING_PROVIDER=azure, also add the required AZURE_OPENAI_* values.

# --- 外部 RAG MCP 知识库（可选）---
# 开启后，知识库语义检索优先委托给外部 MODULAR-RAG-MCP-SERVER（MCP stdio 协议，
# 混合检索 chroma 向量 + BM25 + rerank）；无结果/调用异常时自动回退本地 FAISS 检索。
# RAG 服务端由本进程作为子进程拉起，需保证其 Python 环境可用（chromadb 等依赖已装）。
RAG_MCP_ENABLED=false
# 子进程启动命令与参数（默认 python -m src.mcp_server.server）
# RAG_MCP_COMMAND=python
# RAG_MCP_ARGS=["-m", "src.mcp_server.server"]
# RAG 服务端项目根目录（必须能解析到其 src 包）
RAG_MCP_CWD=C:/Users/Cloud/Desktop/RAG项目/MODULAR-RAG-MCP-SERVER-main
# 限定检索的集合名，留空则由 RAG 服务端使用默认集合（可用 list_collections 确认）
# RAG_MCP_COLLECTION=knowledge_hub
